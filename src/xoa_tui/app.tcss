Screen {
    background: $surface;
}

#connect-form {
    align: center middle;
    width: 64;
    height: auto;
    background: $panel;
    border: round $primary;
    border-title-color: $text-primary;
    border-title-style: bold;
    padding: 1 3;
    margin: 2 4;
}

#connect-form > Label {
    color: $text-muted;
    margin-bottom: 1;
}

#connect-form Input {
    margin-bottom: 1;
    border: round $primary-muted;
}

#connect-form Input:focus {
    border: round $primary;
}

#connect-form Button {
    margin-top: 1;
    width: 100%;
}

#actions {
    height: auto;
    background: $panel;
    border: round $primary-muted;
    border-title-color: $text-muted;
    padding: 1;
    margin: 1 1 0 1;
}

#actions Button {
    margin-right: 1;
}

#output {
    background: $surface;
    border: round $primary;
    border-title-color: $text-primary;
    border-title-style: bold;
    margin: 1;
    padding: 0 1;
    height: 1fr;
}
